[magnetic_field]
file = hall_landmark_b_profile.dat
sha256 = d813ea74a7c098f51349cb58242c91707eaca9bfa278a69155d86cb9683b1d3a
axis = x

[pair_source]
profile = centered_sine_squared
x_min_m = 0.0025
x_max_m = 0.010
y_min_m = 0
