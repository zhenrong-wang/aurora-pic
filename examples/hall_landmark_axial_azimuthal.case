case_manifest_version = 1
case_id = landmark-axial-azimuthal-2019
case_class = verification_benchmark
runtime_config = hall_field_profile_smoke.cfg
status = reduced_integration_only

[reference]
doi = 10.1088/1361-6595/ab46c5
domain_x_m = 0.025
domain_y_m = 0.0128
production_cells_x = 500
production_cells_y = 256
aurorapic_nodes_x = 501
aurorapic_nodes_y = 256
production_dt_s = 5e-12
production_steps = 4000000
discharge_voltage_v = 200
initial_density_m3 = 5e16

[provenance]
article_title = 2D axial-azimuthal particle-in-cell benchmark for low-temperature partially magnetized plasmas
article_url = https://doi.org/10.1088/1361-6595/ab46c5
public_dataset_doi = 10.7302/5mfm-as86
public_dataset_url = https://deepblue.lib.umich.edu/data/concern/data_sets/vq27zp39n
public_dataset_variant = WarpX Case 2, 512 axial by 256 azimuthal cells
public_dataset_license = CC0 1.0
public_dataset_archive_name = baseline_20us.tar
public_dataset_display_size = 29 GB
public_dataset_file_set_id = m900nv362

[magnetic_field]
file = hall_landmark_b_profile.dat
sha256 = d813ea74a7c098f51349cb58242c91707eaca9bfa278a69155d86cb9683b1d3a
axis = x

[pair_source]
profile = centered_sine_squared
x_min_m = 0.0025
x_max_m = 0.010
y_min_m = 0
y_max_m = 0.0128
peak_volumetric_pair_rate_m3_s = 5.23e23
normalized_profile_mean = 0.5
effective_profile_area_m2 = 4.8e-5
out_of_plane_depth_m = 1
derived_represented_pair_rate_s = 2.5104e19
electron_temperature_ev = 10
electron_thermal_velocity_std_m_s = 1326205.1154998604
ion_temperature_ev = 0.5
ion_thermal_velocity_std_m_s = 606.17061564868

[initial_loading]
electron_temperature_ev = 10
electron_thermal_velocity_std_m_s = 1326205.1154998604
ion_temperature_ev = 0.5
ion_thermal_velocity_std_m_s = 606.17061564868

[cathode_control]
emitted_species = electrons
monitor_boundary = left
emission_boundary = right
emission_plane_x_m = 0.024
emission_temperature_ev = 10
emission_thermal_velocity_std_m_s = 1326205.1154998604
potential_reference_axis = x
potential_reference_coordinate_m = 0.024
potential_reference_target_v = 0

[reduced_contract]
max_cells = 128
max_initial_macroparticles = 8
max_steps = 4
max_threads = 1
physics_claim = none
missing_physics = published_population,published_resolution,long_time_averaging

[diagnostics]
profile_axis = x
mode_axis = y
reduced_max_mode = 3
field_profiles = resolved_field_profiles.csv
species_profiles = resolved_species_profiles.csv
mode_history = resolved_modes.csv
field_time_average = resolved_field_time_average.csv
species_time_average = resolved_species_time_average.csv

[comparison]
reference_contract_version = 1
reference_data_policy = external_checksum_pinned
comparator = scripts/compare_hall.py
preflight = scripts/preflight_hall.py
